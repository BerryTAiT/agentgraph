# Copy this file to `.env` in the same folder, then fill in the keys.
# `.env` is git-ignored, so your real keys never get committed.
#
# Only set the keys for the provider you will use. Leave the others empty.

# === LLM providers (pick one or more) ===
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# COHERE_API_KEY=
# AZURE_OPENAI_KEY=
# AWS_BEDROCK_ACCESS_KEY=
# AWS_BEDROCK_SECRET_KEY=

# === Optional: voice / embeddings ===
# ELEVENLABS_API_KEY=
# WHISPER_API_KEY=

# === Optional: fine-tune / vector DB keys ===
